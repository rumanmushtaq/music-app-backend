# Clerk (https://dashboard.clerk.com) — Secret Key from your Clerk instance
CLERK_SECRET_KEY=replace-with-your-clerk-secret-key

# DEV ONLY - set this only if your local machine/container's system clock is out of sync
# with real time (this widens verifyToken's exp/nbf tolerance in milliseconds). Leave unset
# otherwise - never set this in a real deployment, it weakens token expiry validation.
# CLERK_DEV_CLOCK_SKEW_MS=63072000000

# Postgres connection. Either set DATABASE_URL directly...
DATABASE_URL=postgres://postgres:postgres@localhost:5432/music_app

# ...or set these discrete vars, used as a fallback when DATABASE_URL is unset.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=music_app

# Redis (redis-stack works fine here - it speaks the standard Redis protocol).
# Either set REDIS_URL directly...
REDIS_URL=redis://localhost:6379

# ...or set these discrete vars, used as a fallback when REDIS_URL is unset.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

PORT=3000
